---
/**
 * A framed product screenshot that swaps light/dark variants with the theme.
 * Expects `${base}screenshots/<name>-light.png` and `-dark.png` to exist.
 */
interface Props {
  name: string;
  alt: string;
  maxWidth?: number;
  /** Intrinsic size of the PNGs — captured at 2x, so twice the viewport they were shot in. */
  width?: number;
  height?: number;
}
const { name, alt, maxWidth, width = 2880, height = 1800 } = Astro.props;
const base = import.meta.env.BASE_URL;
const style = maxWidth ? `max-width:${maxWidth}px` : undefined;
---

<picture class="shot" style={style}>
  <source srcset={`${base}screenshots/${name}-dark.png`} media="(prefers-color-scheme: dark)" />
  <img
    class="shot-img"
    src={`${base}screenshots/${name}-light.png`}
    alt={alt}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
  />
</picture>

<style>
  .shot {
    display: block;
    width: 100%;
    margin: 0 auto;
  }
  .shot-img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shot-shadow);
  }
</style>
