---
import { links } from "../data/landing";
---

<section class="section container ci">
  <div class="copy">
    <h2 class="heading">Wire it into CI in an afternoon</h2>
    <p class="body">
      One binary and a project-fenced API key: pipelines create, deploy, and
      destroy instances — one preview environment per pull request, torn down
      on merge. <code>--wait</code> follows the deploy and exits non-zero if it
      fails, so a broken environment stops the build instead of passing it.
    </p>
    <div class="doclinks">
      <a class="doclink" href={links.cliDocs}>Read the CLI docs →</a>
      <a class="doclink" href={links.apiDocs}>API keys for CI →</a>
    </div>
  </div>
  <pre class="code"><code>$ fadebox instance up pr-42 --wait -o json \
    | jq -r '.containers[].urls[]'

instance: STARTING
  web: running (healthy)
  api: running (healthy)
instance: RUNNING
https://pr-42-web.preview.example.com
https://pr-42-api.preview.example.com</code></pre>
</section>

<style>
  .ci {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .heading {
    font-size: 32px;
    font-weight: 700;
  }
  .body {
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
  }
  .body code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--ink);
  }
  .doclinks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .doclink {
    font-size: 15px;
    font-weight: 600;
  }
  .code {
    background: var(--code-bg);
    color: var(--code-text);
    border-radius: var(--radius-card);
    padding: 22px 24px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-x: auto;
  }
  .code code {
    font-family: inherit;
  }

  @media (max-width: 720px) {
    .ci {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
