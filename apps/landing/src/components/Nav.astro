---
import { links, showPricing } from "../data/landing";
const base = import.meta.env.BASE_URL;

interface Props {
  /**
   * Prefix for the section anchors. Empty on the home page, where they are
   * same-page jumps; set to the site base on subpages (legal documents), where
   * a bare `#features` would resolve against the subpage's own URL and go
   * nowhere.
   */
  anchorBase?: string;
}
const { anchorBase = "" } = Astro.props;
---

<nav class="nav container">
  <a class="brand" href={anchorBase || "#"} aria-label="fadebox — home">
    <picture>
      <source srcset={`${base}logo-lockup-dark.svg`} media="(prefers-color-scheme: dark)" />
      <img class="lockup" src={`${base}logo-lockup.svg`} alt="fadebox" width="128" height="26" />
    </picture>
  </a>
  <div class="spacer"></div>
  <div class="nav-links">
    <a class="nav-link" href={`${anchorBase}#features`}>Features</a>
    <a class="nav-link" href={`${anchorBase}#how`}>How it works</a>
    {showPricing && <a class="nav-link" href={`${anchorBase}#pricing`}>Pricing</a>}
    <a class="nav-link" href={links.docs}>Docs</a>
  </div>
  <a class="nav-cta" href={`${anchorBase}#cta`}>Get started</a>
</nav>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: 32px;
    /* padding-block, not the shorthand — .nav is also a .container. */
    padding-block: 20px;
    border-bottom: 1px solid var(--border);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .lockup {
    display: block;
    height: 26px;
    width: auto;
  }
  .spacer {
    flex: 1;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .nav-link {
    font-size: 14px;
    text-decoration: none;
  }
  .nav-link:hover {
    text-decoration: underline;
  }
  .nav-cta {
    font-size: 14px;
    text-decoration: none;
    background: var(--brand);
    color: var(--on-brand);
    padding: 9px 18px;
    border-radius: var(--radius-btn);
    transition: background-color 0.15s ease;
  }
  .nav-cta:hover {
    background: var(--brand-hover);
    color: var(--on-brand);
  }

  @media (max-width: 720px) {
    .nav {
      flex-wrap: wrap;
      gap: 16px 20px;
    }
    /*
     * Two rows: brand + CTA, then the links. The CTA is last in the DOM (so tab
     * order still runs through the links first) and `order` lifts it onto the
     * brand's row — left to wrap on its own it lands orphaned on a third line.
     */
    .spacer {
      display: none;
    }
    .nav-cta {
      order: 1;
      margin-left: auto;
    }
    .nav-links {
      order: 2;
      flex-basis: 100%;
      flex-wrap: wrap;
      gap: 12px 18px;
    }
  }
</style>
