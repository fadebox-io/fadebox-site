---
import { links } from "../data/landing";
import Screenshot from "./Screenshot.astro";
---

<header class="hero container">
  <div class="badge">Self-hosted · Docker-native</div>
  <h1 class="title">Self-hosted ephemeral environments on plain Docker</h1>
  <p class="subhead">
    One isolated copy of your stack per branch, per dev, per demo — each with
    its own URL. No Kubernetes. No SaaS control plane.
  </p>
  <div class="actions">
    <a class="btn btn-primary" href={links.install}>Install self-hosted</a>
    <a class="btn btn-secondary" href={links.demo}>Request a demo</a>
  </div>
  <div class="shot">
    <Screenshot
      name="dashboard"
      alt="Fadebox dashboard — projects, environments, running services, and recent deployments with live status"
      maxWidth={1000}
    />
  </div>
</header>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    /* padding-block, not the shorthand — .hero is also a .container. */
    padding-block: 88px 64px;
    position: relative;
    z-index: 0;
  }
  /* Light-mode backdrop: indigo glow plus a dot grid fading out from the
     title area. Both draw from tokens that dark mode sets to nothing. */
  .hero::before,
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .hero::before {
    background: var(--hero-glow);
  }
  .hero::after {
    background-image: radial-gradient(var(--hero-dot) 1px, transparent 1px);
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(720px 420px at 50% 10%, #000, transparent 72%);
    mask-image: radial-gradient(720px 420px at 50% 10%, #000, transparent 72%);
  }
  .badge {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand);
    background: var(--brand-tint);
    border: 1px solid var(--badge-border);
    border-radius: var(--radius-badge);
    padding: 6px 14px;
  }
  .title {
    /* Mono glyphs run wider — smaller size and wider box keep a two-line wrap. */
    font-size: 46px;
    line-height: 1.14;
    font-weight: 700;
    letter-spacing: -0.03em;
    max-width: 820px;
    text-wrap: balance;
  }
  .subhead {
    font-size: 19px;
    line-height: 1.5;
    color: var(--muted);
    margin: 0;
    max-width: 600px;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .shot {
    width: 100%;
    display: flex;
    justify-content: center;
    margin-top: 28px;
  }

  @media (max-width: 720px) {
    .hero {
      padding-block: 56px 48px;
    }
    .title {
      font-size: 32px;
    }
    .subhead {
      font-size: 17px;
    }
  }
</style>
