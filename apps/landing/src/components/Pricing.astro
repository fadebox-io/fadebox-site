---
import { tiers, tierTable, licenceNotes } from "../data/landing";
---

<section id="pricing" class="section container pricing">
  <div class="section-head centered">
    <h2 class="heading">Pricing</h2>
    <p class="sub">
      One flat price per installation, per year. You scale by Docker hosts, not
      by headcount — adding people to fadebox never changes what you pay.
    </p>
  </div>

  <div class="grid">
    {
      tiers.map((t) => (
        <div class:list={["card", { emphasized: t.emphasized }]}>
          <h3 class="name">{t.name}</h3>
          <div class="price-row">
            <span class="price">{t.price}</span>
            {t.priceNote && <span class="price-note">{t.priceNote}</span>}
          </div>
          <p class="body">{t.body}</p>

          <p class="caps">{t.caps}</p>

          <a
            class:list={[
              "btn",
              t.ctaVariant === "primary" ? "btn-primary" : "btn-secondary",
              "cta",
            ]}
            href={t.ctaHref}
          >
            {t.cta}
          </a>
        </div>
      ))
    }
  </div>

  <div class="compare">
    <table>
      <thead>
        <tr>
          <th></th>
          {tiers.map((t) => <th>{t.name}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          tierTable.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              {row.values.map((v) => <td>{v}</td>)}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="fineprint">
    Prices exclude VAT. The Free tier needs no licence key at all — install and run.
    Fadebox runs entirely on your own hardware and never phones home — on any
    tier, licensed or not.
  </p>

  <div class="notes">
    {
      licenceNotes.map((n) => (
        <div class="note">
          <h3 class="note-title">{n.title}</h3>
          <p class="note-body">{n.body}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .pricing {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .centered {
    text-align: center;
    align-items: center;
    max-width: 640px;
    margin: 0 auto;
  }
  .heading {
    font-size: 32px;
    font-weight: 700;
  }
  .sub {
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-width: 1020px;
    margin: 0 auto;
    width: 100%;
    align-items: stretch;
  }
  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .card.emphasized {
    border-width: 2px;
    border-color: var(--brand);
  }
  .name {
    font-size: 18px;
    font-weight: 700;
  }
  /* Price and its billing unit share a baseline so the three cards line up
     even though only the paid tiers carry a note. */
  .price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    min-height: 38px;
  }
  .price {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .price-note {
    font-size: 13px;
    color: var(--muted);
  }
  /* flex: 1 absorbs the body-length differences, so the caps line and the
     CTA sit bottom-aligned across all three cards. */
  .body {
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
    margin: 0;
    flex: 1;
  }
  /* The tier's one spec line, styled as a bordered spec-sheet row. */
  .caps {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 12px 0;
    margin: 0;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 600;
  }
  /* Full-width tier CTA, following the card's box; overrides the default
     inline button padding. */
  .cta {
    padding: 11px 0;
    font-size: 14px;
  }
  .cta.btn-secondary {
    border-color: var(--ink);
  }
  /* The numbers at a glance. Same width as the cards so the columns read as
     their continuation; scrolls sideways on narrow screens rather than
     squeezing the labels. */
  .compare {
    max-width: 1020px;
    margin: 0 auto;
    width: 100%;
    overflow-x: auto;
  }
  .compare table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    line-height: 1.4;
  }
  .compare th,
  .compare td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    text-align: center;
    min-width: 110px;
  }
  .compare thead th {
    font-size: 13px;
    font-weight: 700;
    border-bottom-width: 2px;
  }
  .compare tbody th {
    text-align: left;
    font-weight: 400;
    color: var(--muted);
    min-width: 220px;
  }
  .compare td {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .fineprint {
    font-size: 13px;
    line-height: 1.6;
    color: var(--faint);
    text-align: center;
    max-width: 620px;
    margin: -16px auto 0;
  }
  .notes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    padding-top: 36px;
    border-top: 1px solid var(--border);
  }
  .note {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .note-title {
    font-size: 15px;
    font-weight: 700;
  }
  .note-body {
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
    margin: 0;
  }

  @media (max-width: 980px) {
    .notes {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px 24px;
    }
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .notes {
      grid-template-columns: 1fr;
    }
    .body {
      flex: none;
    }
  }
</style>
