---
/**
 * Inline stroke icons, 24×24, drawn in `currentColor`. Kept in-repo rather than
 * pulled from an icon package — a handful of shapes doesn't justify the
 * dependency, and inlining keeps the page free of extra requests.
 *
 * `name` must be a key of `icons` below; unknown names render nothing.
 */
interface Props {
  name: string;
  size?: number;
}
const { name, size = 20 } = Astro.props;

const icons: Record<string, string> = {
  /* Ephemeral by design — a timer: the environment is time-boxed. */
  timer: `<path d="M10 2h4"/><circle cx="12" cy="14" r="8"/><path d="M12 14v-4"/>`,
  /* Preview URL per instance — a globe with meridian. */
  globe: `<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c-3.2 3.5-3.2 14.5 0 18c3.2-3.5 3.2-14.5 0-18z"/>`,
  /* Compose-native templates — a file with code chevrons. */
  "file-code": `<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M10.2 12.6 8.6 14.2l1.6 1.6"/><path d="M13.8 12.6l1.6 1.6-1.6 1.6"/>`,
  /* Multi-runtime — stacked daemons. */
  server: `<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01"/><path d="M7 16.5h.01"/>`,
  /* Template catalog — a grid of ready-made blocks. */
  grid: `<rect x="3" y="3" width="7.5" height="7.5" rx="1.5"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5"/>`,
  /* Git value sources — a branch. */
  "git-branch": `<path d="M6 3v12"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>`,
};

const markup = icons[name];
---

{
  markup && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      set:html={markup}
    />
  )
}
